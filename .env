# ── Server ──────────────────────────────
# Everything runs on ONE port — the backend serves the built frontend too
PORT=4000

# ── Auth ─────────────────────────────────
JWT_SECRET=74970a6e79ef60a96f956afcaca3f8dd48008655e8fe770608e84779b0c262fa8da7d951334fb97d288c06b462ee2827
SETUP_KEY=setup-1234  # used to create the first admin account

# ── Email (SMTP) ─────────────────────────
# Use Gmail, SendGrid, Postmark, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password   # Gmail: use an App Password, not your real password
FROM_EMAIL=you@yourdomain.com
BRAND_NAME=Tractify

# ── Google Calendar ───────────────────────
# 1. Go to console.cloud.google.com
# 2. Create project → Enable Calendar API
# 3. Credentials → OAuth 2.0 Client ID → Web application
# 4. Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
